{
  "name": "@receptron/sharedapp",
  "version": "0.29.0",
  "description": "The shared-app compiler: app.json to Firestore documents, and what publish refuses.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/receptron/sharedapp.git"
  },
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./view": {
      "types": "./dist/view/index.d.ts",
      "default": "./dist/view/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "check:apps": "tsx scripts/check-apps.mjs",
    "check:pack": "node scripts/check-pack.mjs",
    "format": "prettier --write \"{src,test}/**/*.ts\" \"scripts/**/*.{mjs,ts}\" \"*.{json,md}\" \"{scripts,test}/tsconfig.json\"",
    "format:check": "prettier --check \"{src,test}/**/*.ts\" \"scripts/**/*.{mjs,ts}\" \"*.{json,md}\" \"{scripts,test}/tsconfig.json\"",
    "lint": "eslint src test scripts",
    "prepare": "tsc -p tsconfig.json",
    "prepublishOnly": "tsc -p tsconfig.json",
    "test": "tsx --test ./test/test_*.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p test/tsconfig.json --noEmit && tsc -p scripts/tsconfig.json --noEmit",
    "typecheck:summary": "tsx scripts/typecheck-summary.ts"
  },
  "dependencies": {
    "zod": "^4.1.13"
  },
  "peerDependencies": {
    "@mulmoclaude/core": "^4.0.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@mulmoclaude/core": "4.0.0",
    "@types/node": "^22.0.0",
    "eslint": "^10.9.0",
    "eslint-plugin-security": "^4.0.1",
    "eslint-plugin-sonarjs": "^4.2.0",
    "prettier": "^3.0.0",
    "tsx": "^4.0.0",
    "type-coverage": "^2.30.1",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.0.0"
  },
  "publishConfig": {
    "access": "public"
  }
}
