{
  "name": "@receptron/sharedapp",
  "version": "0.18.0",
  "description": "The shared-app compiler: app.json to Firestore documents, and what publish refuses.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/receptron/sharedapp.git"
  },
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./view": {
      "types": "./dist/view/index.d.ts",
      "default": "./dist/view/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "format": "prettier --write \"{src,test}/**/*.ts\" \"scripts/**/*.mjs\" \"*.{json,md}\"",
    "format:check": "prettier --check \"{src,test}/**/*.ts\" \"scripts/**/*.mjs\" \"*.{json,md}\"",
    "lint": "eslint src test scripts",
    "prepare": "tsc -p tsconfig.json",
    "prepublishOnly": "tsc -p tsconfig.json",
    "test": "tsx --test ./test/test_*.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p test/tsconfig.json --noEmit"
  },
  "dependencies": {
    "zod": "^4.1.13"
  },
  "peerDependencies": {
    "@mulmoclaude/core": "^4.0.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.0.0",
    "@mulmoclaude/core": "4.0.0",
    "@types/node": "^22.0.0",
    "eslint": "^9.0.0",
    "prettier": "^3.0.0",
    "tsx": "^4.0.0",
    "typescript": "^5.9.0",
    "typescript-eslint": "^8.0.0"
  },
  "publishConfig": {
    "access": "public"
  }
}
